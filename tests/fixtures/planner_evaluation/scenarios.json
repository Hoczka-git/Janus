{
  "scenarios": [
    {
      "id": "S01",
      "name": "Single urgent task",
      "description": "Verify the planner elevates a single urgent task to HIGH priority.",
      "context": {
        "goals": [
          {
            "title": "Career",
            "status": "active",
            "related_tasks": ["Write plan"]
          }
        ],
        "tasks": [
          {
            "title": "Write plan",
            "due_date": "today",
            "priority": 1
          }
        ],
        "calendar": [],
        "signals": {
          "due_soon_tasks": ["Write plan"]
        }
      },
      "expected": {
        "min_task_coverage": 1.0,
        "plan_validity": true,
        "expected_priority_goals": ["Career"]
      },
      "planner_type": "rule_based"
    },
    {
      "id": "S02",
      "name": "Multiple overdue tasks",
      "description": "All overdue tasks must be flagged HIGH priority and appear in risks.",
      "context": {
        "goals": [
          {
            "title": "Career",
            "status": "active",
            "related_tasks": ["Overdue A", "Overdue B", "Overdue C"]
          }
        ],
        "tasks": [
          {"title": "Overdue A", "due_date": "today-10"},
          {"title": "Overdue B", "due_date": "today-5"},
          {"title": "Overdue C", "due_date": "today-1"}
        ],
        "calendar": [],
        "signals": {
          "overdue_tasks": ["Overdue A", "Overdue B", "Overdue C"]
        }
      },
      "expected": {
        "min_task_coverage": 1.0,
        "overdue_handling": true,
        "plan_validity": true,
        "expected_risk_keywords": ["Overdue"]
      },
      "planner_type": "rule_based"
    },
    {
      "id": "S03",
      "name": "Stalled goal",
      "description": "A goal with no recent activity must be flagged as HIGH priority and in risks.",
      "context": {
        "goals": [
          {
            "title": "Stalled Goal",
            "status": "active",
            "recent_activity": null
          },
          {
            "title": "Active Goal",
            "status": "active",
            "recent_activity": [{"task_id": "t1", "date": "2026-10-01"}]
          }
        ],
        "tasks": [],
        "calendar": [],
        "signals": {
          "stalled_goals": ["Stalled Goal"]
        }
      },
      "expected": {
        "plan_validity": true,
        "expected_priority_goals": ["Stalled Goal"],
        "expected_risk_keywords": ["Stalled"]
      },
      "planner_type": "rule_based"
    },
    {
      "id": "S04",
      "name": "No calendar availability",
      "description": "Planner should handle week with zero free slots (all days have events).",
      "context": {
        "goals": [
          {
            "title": "Career",
            "status": "active",
            "related_tasks": ["Task A", "Task B"]
          }
        ],
        "tasks": [
          {"title": "Task A", "due_date": "today+1"},
          {"title": "Task B", "due_date": "today+3"}
        ],
        "calendar": [
          {"title": "Mon", "start": "today", "all_day": true},
          {"title": "Tue", "start": "today+1", "all_day": true},
          {"title": "Wed", "start": "today+2", "all_day": true},
          {"title": "Thu", "start": "today+3", "all_day": true},
          {"title": "Fri", "start": "today+4", "all_day": true},
          {"title": "Sat", "start": "today+5", "all_day": true},
          {"title": "Sun", "start": "today+6", "all_day": true}
        ],
        "signals": {
          "calendar_conflicts": [
            "Task 'Task A' due on today+1 conflicts with calendar event",
            "Task 'Task B' due on today+3 conflicts with calendar event"
          ]
        }
      },
      "expected": {
        "min_task_coverage": 1.0,
        "min_calendar_conflict_rate": 1.0,
        "plan_validity": true
      },
      "planner_type": "rule_based"
    },
    {
      "id": "S05",
      "name": "Deadline conflict",
      "description": "Two tasks with the same deadline should be flagged as competing.",
      "context": {
        "goals": [
          {
            "title": "Career",
            "status": "active",
            "related_tasks": ["Task A", "Task B"]
          }
        ],
        "tasks": [
          {"title": "Task A", "due_date": "today+3"},
          {"title": "Task B", "due_date": "today+3"}
        ],
        "calendar": [],
        "signals": {
          "competing_tasks": {"Task A": 2, "Task B": 2}
        }
      },
      "expected": {
        "min_task_coverage": 1.0,
        "deadline_awareness": true,
        "plan_validity": true,
        "expected_risk_keywords": ["Competing"]
      },
      "planner_type": "rule_based"
    },
    {
      "id": "S06",
      "name": "Too many tasks for available capacity",
      "description": "Planner must handle 10+ tasks in a single week without crashing.",
      "context": {
        "goals": [
          {"title": "Career", "status": "active", "related_tasks": ["T1", "T2", "T3", "T4"]},
          {"title": "Health", "status": "active", "related_tasks": ["T5", "T6", "T7"]},
          {"title": "Learning", "status": "active", "related_tasks": ["T8", "T9", "T10"]}
        ],
        "tasks": [
          {"title": "T1", "due_date": "today-3"},
          {"title": "T2", "due_date": "today-2"},
          {"title": "T3", "due_date": "today-1"},
          {"title": "T4", "due_date": "today+1"},
          {"title": "T5", "due_date": "today+1"},
          {"title": "T6", "due_date": "today+2"},
          {"title": "T7", "due_date": "today+3"},
          {"title": "T8", "due_date": "today+4"},
          {"title": "T9", "due_date": "today+5"},
          {"title": "T10", "due_date": "today+6"}
        ],
        "calendar": [],
        "signals": {
          "overdue_tasks": ["T1", "T2", "T3"],
          "due_soon_tasks": ["T4", "T5", "T6", "T7"],
          "competing_tasks": {"T4": 2, "T5": 2}
        }
      },
      "expected": {
        "min_task_coverage": 0.5,
        "plan_validity": true
      },
      "planner_type": "rule_based"
    },
    {
      "id": "S07",
      "name": "Empty task list",
      "description": "Planner must produce a valid plan with zero tasks.",
      "context": {
        "goals": [
          {"title": "Career", "status": "active"}
        ],
        "tasks": [],
        "calendar": [],
        "signals": {}
      },
      "expected": {
        "min_task_coverage": 1.0,
        "plan_validity": true
      },
      "planner_type": "rule_based"
    },
    {
      "id": "S08",
      "name": "Goal without associated tasks",
      "description": "A goal with no related tasks must still appear in priorities.",
      "context": {
        "goals": [
          {"title": "Career", "status": "active", "related_tasks": []},
          {"title": "Health", "status": "active", "related_tasks": ["Task X"]}
        ],
        "tasks": [
          {"title": "Task X", "due_date": "today+3"}
        ],
        "calendar": [],
        "signals": {}
      },
      "expected": {
        "min_task_coverage": 1.0,
        "plan_validity": true,
        "expected_priority_goals": ["Career"]
      },
      "planner_type": "rule_based"
    },
    {
      "id": "S09",
      "name": "Conflicting priorities",
      "description": "When two goals both claim HIGH priority, planner must produce consistent ordering.",
      "context": {
        "goals": [
          {"title": "Urgent Goal", "status": "active", "deadline": "today+2", "related_tasks": ["Task A"]},
          {"title": "Also Urgent Goal", "status": "active", "deadline": "today+1", "related_tasks": ["Task B"]}
        ],
        "tasks": [
          {"title": "Task A", "due_date": "today+1"},
          {"title": "Task B", "due_date": "today"}
        ],
        "calendar": [],
        "signals": {
          "due_soon_tasks": ["Task A", "Task B"]
        }
      },
      "expected": {
        "min_task_coverage": 1.0,
        "deadline_awareness": true,
        "plan_validity": true
      },
      "planner_type": "rule_based"
    },
    {
      "id": "S10",
      "name": "Blocked dependency",
      "description": "A task in blocked state must be flagged.",
      "context": {
        "goals": [
          {
            "title": "Career",
            "status": "active",
            "related_tasks": ["Blocked Task", "Unblocked Task"]
          }
        ],
        "tasks": [
          {"title": "Blocked Task", "due_date": "today+5", "state": "blocked"},
          {"title": "Unblocked Task", "due_date": "today+1", "state": "todo"}
        ],
        "calendar": [],
        "signals": {
          "due_soon_tasks": ["Unblocked Task"]
        }
      },
      "expected": {
        "min_task_coverage": 1.0,
        "deadline_awareness": true,
        "plan_validity": true
      },
      "planner_type": "rule_based"
    }
  ]
}
